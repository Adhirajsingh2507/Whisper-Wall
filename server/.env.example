# MongoDB Connection
# Get your connection string from MongoDB Atlas (cloud.mongodb.com)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/whisper-wall?retryWrites=true&w=majority

PORT=5000

# Frontend URL (for CORS)
# Use comma-separated values for multiple origins
CLIENT_URL=http://localhost:3000,http://localhost:5173

# Node Environment
NODE_ENV=development
